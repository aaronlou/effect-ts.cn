{
  "name": "@ecn/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect 中文知识层的 MCP Server：把站内中文译文以 MCP 工具暴露给编码 Agent（stdio 传输，离线自包含）",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ecn/knowledge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
