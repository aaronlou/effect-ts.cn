{
  "name": "@ecn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect 中文社区后端：Effect + @effect/platform HTTP，DDD 洋葱分层（interfaces/application/domain/infrastructure）",
  "scripts": {
    "dev": "pnpm --filter @ecn/contracts build && tsx watch --clear-screen=false src/bootstrap/main.ts",
    "start": "tsx src/bootstrap/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ecn/contracts": "workspace:*",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
