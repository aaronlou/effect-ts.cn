---
import "../styles/global.css"
import SearchDialog from "../components/SearchDialog.astro"
import AskPanel from "../components/AskPanel.astro"
import AgentDock from "../components/AgentDock.astro"
import SelectionAgent from "../components/SelectionAgent.astro"
import { MONETIZATION } from "../data/monetization"

interface Props {
  title?: string
  description?: string
  /**
   * 是否由本布局注入**全站**问答面板与常驻 Agent 入口（默认 true）。
   * 文档页与 /ask 自带（前者带 scope＝"问这一页"），因此传 false 避免重复挂载。
   */
  withAsk?: boolean
  /**
   * 页面自身的可定位信息：`data-*` 挂在 `<html>` 上，供选区快照（scripts/selection.ts）读取。
   * 有这三项，"选中一段 → 讲讲"才能被钉回 `slug#anchor@commit`（切片 B 会随请求发给后端）。
   */
  docSlug?: string
  docVersion?: string
  docCommit?: string
  /**
   * 该页对应的**官方英文原文**地址（译文页才传）。
   *
   * 为什么重要：本页是译文。不声明与原文的关系，搜索引擎容易把它当成
   * "重复内容"而不是"同一份文档的中文版本"；声明之后（hreflang + isBasedOn）
   * 它才以"中文版"的身份参与排序 —— 这正是我们要被搜到的身份。
   */
  officialUrl?: string
}
const {
  title = "Effect 中文社区",
  description = "面向 AI 时代的可靠 TypeScript —— Effect 的中文第一入口",
  withAsk = true,
  docSlug,
  docVersion,
  docCommit,
  officialUrl
} = Astro.props
/**
 * 标题拼接：调用方若已给出完整标题（含站点名），原样使用。
 *
 * 起因：首页此前传 `title="首页"`，于是最值钱的标题位显示成「首页 · Effect 中文社区」——
 * 没人会搜"首页"。SEO 上第一屏标题是最高权重的关键词位，不能浪费。
 */
const siteTitle = title.includes("Effect 中文社区") ? title : `${title} · Effect 中文社区`

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://effect-ts.cn")
const canonicalUrl = canonical.href

/**
 * 文档页用更宽的容器（见 global.css 的 `--container-max`）。
 *
 * 关键：**页头必须跟着一起宽**。页头与正文各自居中、宽度却不同的话，
 * 导航的左边缘会和侧栏、右边缘会和「本页目录」错开 —— 视觉上像排版坏了。
 * 所以这里把"宽容器"做成整个页面的属性（`<body data-wide>`），而不是只给正文加类。
 */
const wide = docSlug !== undefined
---
<!doctype html>
<html lang="zh-CN" data-doc-slug={docSlug} data-doc-version={docVersion} data-doc-commit={docCommit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#6e56cf" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Effect 中文社区" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* 同一份文档的中英文两个版本：让搜索引擎知道这是「中文版」，而不是「重复内容」 */}
    {
      officialUrl !== undefined && (
        <>
          <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
          <link rel="alternate" hreflang="en" href={officialUrl} />
        </>
      )
    }

    {/*
      结构化数据（schema.org / JSON-LD）。
      搜索引擎与 AI 抓取器都靠它理解"这个页面是什么"：
      - WebSite + SearchAction：声明本站是一个可搜索的站点；
      - TechArticle + isBasedOn：译文页声明它翻译自哪一篇官方文档。
      没有这一层，AI 只能靠猜正文 —— 而它猜错的代价是引用别人。
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        officialUrl !== undefined
          ? {
              "@context": "https://schema.org",
              "@type": "TechArticle",
              headline: title,
              inLanguage: "zh-CN",
              url: canonicalUrl,
              isBasedOn: officialUrl,
              translationOfWork: officialUrl,
              isPartOf: { "@type": "WebSite", name: "Effect 中文社区", url: "https://effect-ts.cn/" },
              ...(description !== undefined ? { description } : {})
            }
          : {
              "@context": "https://schema.org",
              "@type": "WebSite",
              name: "Effect 中文社区",
              alternateName: ["Effect 中文文档", "effect-ts.cn"],
              url: "https://effect-ts.cn/",
              inLanguage: "zh-CN",
              description,
              potentialAction: {
                "@type": "SearchAction",
                target: "https://effect-ts.cn/docs/?q={search_term_string}",
                "query-input": "required name=search_term_string"
              }
            }
      )}
    />

    {/* 广告与统计都**默认关闭**（见 data/monetization.ts 里的理由与开关）。
        关闭时这里不输出任何第三方脚本 —— 不加载、不拖慢、不产生请求。 */}
    {
      MONETIZATION.ads.enabled && MONETIZATION.ads.client.trim() !== "" && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${MONETIZATION.ads.client}${
            MONETIZATION.ads.nonPersonalized ? "&npa=1" : ""
          }`}
          crossorigin="anonymous"
        />
      )
    }
    {
      MONETIZATION.analytics.enabled && MONETIZATION.analytics.websiteId.trim() !== "" && (
        <script
          defer
          src={MONETIZATION.analytics.scriptUrl}
          data-website-id={MONETIZATION.analytics.websiteId}
        />
      )
    }

    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Effect 中文社区" />
    <meta property="og:locale" content="zh_CN" />
  </head>
  <body data-wide={wide ? "1" : undefined}>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">E</span>
          <span class="brand-text">Effect 中文社区</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/docs/">文档</a>
          <a href="/blog/">博客</a>
          <a href="/glossary/">术语表</a>
          <a href="/ecosystem/">生态项目</a>
          <a href="/errors/">报错百科</a>
          <a href="/ask/">问文档</a>
          <a href="/community/">社区</a>
          <button type="button" class="search-trigger" data-search-open aria-label="站内搜索">
            搜索 <kbd>⌘K</kbd>
          </button>
          <a href="https://github.com/aaronlou/effect-ts.cn" rel="external">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {withAsk && <AskPanel />}
    <AgentDock />
    <SelectionAgent />

    <footer class="site-footer">
      <div class="container">
        <p>
          非官方社区站（与 Effectful Technologies 无隶属关系）· 译文遵循上游 MIT 许可并标注原文与基线
          commit · <a href="/about/">关于</a> ·
          <a href="/contact/">联系</a> ·
          <a href="/sponsor/">赞助</a> ·
          <a href="/privacy/">隐私与 Cookie</a> ·
          <a href="/docs/translation-status/">翻译进度</a> ·
          <a href="/rss.xml">RSS</a> ·
          <a href="/llms.txt">llms.txt</a> ·
          <a href="/llms-full.txt">llms-full.txt</a> ·
          <a href="/debug/">报错诊断</a> ·
          <a href="https://github.com/aaronlou/effect-ts.cn" rel="external">源码</a>
        </p>
        <p class="footer-note">本站由 Astro + Effect + DDD 构建（dogfooding 中）</p>
      </div>
    </footer>

    <SearchDialog />
  </body>
</html>
