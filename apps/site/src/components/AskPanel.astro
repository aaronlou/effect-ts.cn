---
import Mascot from "./Mascot.astro"

/**
 * 「问这一页 / 问全站」面板（渐进增强，零第三方依赖）。
 *
 * 设计取向（诚实优先）：
 * - 面板明确显示当前模式：`检索合成`（无模型，逐句来自站内译文）或 `模型润色`；
 * - 答案永远附「依据」引用，点引用直达该小节；没有依据时展示拒答与"中文未翻译"建议；
 * - 后端不可用时给出明确提示，而不是转圈或假装在思考（站点内容本身不受影响）；
 * - **是一个会话，不是搜索框**：每轮都看得见自己的问题，并且把最近 3 轮的
 *   "问题 + 引用了哪一页哪一节"作为 `history` 回传 —— 服务端据此做指代消解
 *   （"它呢？""那 v3 呢？"），但每轮仍重新检索、重新给引用（对话不豁免取证）。
 */
interface Props {
  /** 限定页面（"问这一页"）：形如 v4/getting-started/installation */
  scope?: string
  /** 在 /ask 独立页面中使用全站模式 */
  standalone?: boolean
}
const { scope, standalone = false } = Astro.props
---

<div
  id="ecn-ask"
  class="search-overlay"
  hidden
  data-scope={scope ?? ""}
  data-standalone={standalone ? "1" : "0"}
>
  <div class="search-panel ask-panel" role="dialog" aria-modal="true" aria-label="向站内文档提问">
    <div class="ask-head">
      <span class="ask-head-title">
        <Mascot size={30} />
        <span class="ask-title">{scope !== undefined ? "问这一页" : "问站内中文文档"}</span>
      </span>
      <span class="ask-head-actions">
        <span class="ask-mode" id="ecn-ask-mode">正在检查后端…</span>
        <button type="button" class="ask-reset" id="ecn-ask-reset" hidden>新对话</button>
      </span>
    </div>
    <div id="ecn-ask-body" class="ask-body">
      <p class="ask-hint">
        答案由站内中文译文检索合成，<strong>每句都带引用</strong>；找不到依据会直接说"不知道"。
        引用可点开原页面小节。可以接着追问 —— 小效记得刚才聊的是哪一页。
      </p>
      <div class="ask-examples" id="ecn-ask-examples">
        <span class="ask-examples-title">试着问：</span>
        <button type="button" class="ask-example" data-question="怎么安装 Effect？">怎么安装 Effect？</button>
        <button type="button" class="ask-example" data-question="怎么把 Promise 包成 Effect？">
          怎么把 Promise 包成 Effect？
        </button>
        <button type="button" class="ask-example" data-question="Layer 怎么做依赖注入？">
          Layer 怎么做依赖注入？
        </button>
        <button type="button" class="ask-example" data-question="Effect 的错误分哪两类？">
          Effect 的错误分哪两类？
        </button>
      </div>
    </div>
    <form id="ecn-ask-form" class="ask-form" autocomplete="off">
      <input
        id="ecn-ask-input"
        class="search-input"
        type="text"
        placeholder="例如：怎么把 Promise 包成 Effect？"
        aria-label="你的问题"
      />
      <button type="submit" class="btn btn-primary ask-submit">提问</button>
    </form>
    <div class="search-hint">
      <span><kbd>Enter</kbd> 提问</span>
      <span><kbd>Esc</kbd> 关闭</span>
      <span class="search-hint-open"><kbd>⌘</kbd><kbd>I</kbd></span>
    </div>
  </div>
</div>

<script>
  import {
    buildClientSearchIndex,
    excerptAround,
    type ClientSearchEntry
  } from "@ecn/knowledge/client-search"

  interface Citation {
    slug: string
    version: string
    title: string
    url: string
    officialUrl: string
    commit?: string
    status: string
    anchor?: string
    quote: string
  }
  interface AskResponse {
    question: string
    mode: "extractive" | "llm"
    answer: string
    citations: ReadonlyArray<Citation>
    refused: boolean
    refusal?: {
      reason: "no-match" | "untranslated"
      message: string
      suggestions?: ReadonlyArray<{ slug: string; title: string; officialUrl: string }>
      relatedPages?: ReadonlyArray<{ slug: string; title: string; url: string; translated: boolean }>
    }
    stalePages: ReadonlyArray<{ slug: string; status: string }>
    disclaimer: string
    /** 本轮实际送去检索的问题（仅当它与 question 不同才存在）：追问被指代消解后的样子 */
    resolvedQuestion?: string
    /** 本轮用过的术语化改写查询（仅当发生过扩展才存在） */
    expandedQueries?: ReadonlyArray<string>
  }

  interface Turn {
    readonly question: string
    /** 本轮的答案（后端给了结果才会有） */
    response?: AskResponse
    /** 已经构建好的 DOM（问答块或本地降级块）：重渲染时直接复用，避免重复请求 */
    element?: HTMLElement
  }

  const overlay = document.getElementById("ecn-ask")
  const input = document.getElementById("ecn-ask-input")
  const body = document.getElementById("ecn-ask-body")
  const modeLabel = document.getElementById("ecn-ask-mode")
  const resetButton = document.getElementById("ecn-ask-reset")
  const form = document.getElementById("ecn-ask-form")

  if (
    overlay instanceof HTMLElement &&
    input instanceof HTMLInputElement &&
    body instanceof HTMLElement &&
    form instanceof HTMLFormElement
  ) {
    const scope = overlay.dataset.scope ?? ""
    /** 回传给服务端的历史轮数上限（与契约的 maxItems(3) 对齐） */
    const HISTORY_TURNS = 3
    let busy = false
    const turns: Array<Turn> = []

    /** 空态（提示 + 示例问题）：先摘下来存着，会话清空后原样放回（监听器随之保留） */
    const initial = document.createElement("div")
    while (body.firstChild !== null) initial.append(body.firstChild)

    const el = (tag: string, className?: string, text?: string): HTMLElement => {
      const node = document.createElement(tag)
      if (className !== undefined) node.className = className
      if (text !== undefined) node.textContent = text
      return node
    }

    const statusBadge = (status: string): HTMLElement => {
      const labels: Record<string, string> = {
        published: "已发布",
        reviewing: "审校中",
        translating: "翻译中",
        pending: "待翻译",
        stale: "落后上游"
      }
      return el("span", "badge dim", labels[status] ?? status)
    }

    const renderCitations = (citations: ReadonlyArray<Citation>): HTMLElement => {
      const list = el("ul", "ask-citations")
      citations.forEach((citation, index) => {
        const item = el("li")
        const link = document.createElement("a")
        link.href = `${citation.url}${citation.anchor !== undefined ? `#${citation.anchor}` : ""}`
        link.textContent = `${index + 1}. 《${citation.title}》`
        item.append(link)
        if (citation.anchor !== undefined) {
          item.append(el("span", "ask-anchor", ` · #${citation.anchor}`))
        }
        item.append(statusBadge(citation.status))
        if (citation.commit !== undefined) {
          item.append(el("code", "ask-commit", `@${citation.commit.slice(0, 7)}`))
        }
        const quote = el("blockquote", "ask-quote", citation.quote)
        item.append(quote)
        list.append(item)
      })
      return list
    }

    /** 反馈回路：把问题、模式、引用与回答一起带进 Issue（零后端、零垃圾数据） */
    const reportUrl = (response: AskResponse): string => {
      const citations = response.citations
        .map(
          (citation) =>
            `${citation.slug}${citation.anchor !== undefined ? `#${citation.anchor}` : ""}@${(citation.commit ?? "?").slice(0, 7)}`
        )
        .join("\n")
      const body = [
        `问题：${response.question}`,
        ...(response.resolvedQuestion !== undefined && response.resolvedQuestion !== response.question
          ? [`检索用的问题：${response.resolvedQuestion}`]
          : []),
        "",
        `模式：${response.mode}`,
        "",
        "引用：",
        citations === "" ? "（无）" : citations,
        "",
        "问题描述：（答案不对 / 引用过期 / 答非所问 / 术语错误 …）",
        "",
        "---",
        "回答内容（截断）：",
        "```",
        response.answer.slice(0, 1000),
        "```"
      ].join("\n")
      return `https://github.com/aaronlou/effect-ts.cn/issues/new?labels=ai-feedback&title=${encodeURIComponent(
        `[AI 反馈] ${response.question.slice(0, 40)}`
      )}&body=${encodeURIComponent(body)}`
    }

    const renderReport = (response: AskResponse): HTMLElement => {
      const footer = el("p", "ask-report")
      const link = document.createElement("a")
      link.href = reportUrl(response)
      link.target = "_blank"
      link.rel = "external"
      link.textContent = "这个回答有问题？报告（自动附上问题与引用）→"
      footer.append(link)
      return footer
    }

    /**
     * 降级路径：API 未部署 / 不可达时，用构建期索引在浏览器里直接检索。
     *
     * 为什么这样做：本项目的默认部署形态是静态托管，若 AI 面板只会说"服务不可用"，
     * 那 AI 能力就是**消失**而不是**降级** —— 那才是真的不好用。
     * 这里明确标注"未连接问答服务"，只给页面级候选与摘录（没有锚点、没有模型、没有引用不变量）。
     */
    const localBlock = async (question: string): Promise<HTMLElement> => {
      const box = el("div", "ask-refusal")
      box.append(el("p", "ask-refusal-title", "问答服务未连接：先用站内索引在本地检索"))
      try {
        const response = await fetch("/search-index.json")
        const entries = (await response.json()) as ReadonlyArray<ClientSearchEntry>
        const hits = buildClientSearchIndex(entries).search(question, 3)
        if (hits.length === 0) {
          box.append(
            el(
              "p",
              undefined,
              "本地索引里没有相关页面。可以用 ⌘K 换关键词搜索，或到 GitHub 提 Issue 告诉我们你想看什么。"
            )
          )
        } else {
          box.append(el("p", undefined, "与这个问题最相关的站内页面（浏览器内检索，未调用任何服务）："))
          const list = el("ul", "ask-suggestions")
          for (const hit of hits) {
            const item = el("li")
            const link = document.createElement("a")
            link.href = hit.entry.url
            link.textContent = hit.entry.title
            item.append(link)
            if (!hit.entry.translated) item.append(el("span", "ask-anchor", " · 未翻译（英文原文）"))
            const excerpt = excerptAround(hit.entry.text, question, 140)
            if (excerpt !== "") item.append(el("p", "ask-anchor", excerpt))
            list.append(item)
          }
          box.append(list)
        }
      } catch {
        box.append(el("p", undefined, "连站内索引也没能加载。请检查网络后重试。"))
      }
      const hint = el("p", "ask-hint")
      hint.append(
        document.createTextNode(
          "部署后端（见 docs/deployment.md）后这里会给出可点回原文锚点的引用、话题归属与拒答判定。"
        )
      )
      box.append(hint)
      return box
    }

    /** 一轮答案（含拒答）：纯 DOM 构建，不改动面板状态 —— 因此可以并存多轮 */
    const answerBlock = (response: AskResponse): HTMLElement => {
      const box = el("div", "ask-turn-a")
      if (response.refused) {
        const refusal = el("div", "ask-refusal")
        refusal.append(
          el(
            "p",
            "ask-refusal-title",
            response.refusal?.reason === "untranslated"
              ? "中文文档里还没有这一页"
              : "没有找到能支撑回答的内容"
          )
        )
        refusal.append(el("p", undefined, response.refusal?.message ?? ""))
        const suggestions = response.refusal?.suggestions ?? []
        if (suggestions.length > 0) {
          const list = el("ul", "ask-suggestions")
          for (const suggestion of suggestions) {
            const item = el("li")
            const link = document.createElement("a")
            link.href = suggestion.officialUrl
            link.target = "_blank"
            link.rel = "external"
            link.textContent = `${suggestion.title}（英文原文 ↗）`
            item.append(link)
            item.append(el("span", "ask-anchor", ` · ${suggestion.slug}`))
            list.append(item)
          }
          refusal.append(list)
        }
        const related = response.refusal?.relatedPages ?? []
        if (related.length > 0) {
          refusal.append(el("p", "ask-related-title", "最接近的站内页面（不构成引用，仅供参考）："))
          const relatedList = el("ul", "ask-suggestions")
          for (const page of related) {
            const item = el("li")
            const link = document.createElement("a")
            link.href = page.url
            link.textContent = `《${page.title}》`
            item.append(link)
            relatedList.append(item)
          }
          refusal.append(relatedList)
        }
        const cta = el("p", "ask-cta")
        const claim = document.createElement("a")
        claim.href = `https://github.com/aaronlou/effect-ts.cn/issues/new?labels=translation&title=${encodeURIComponent(`[翻译认领] ${suggestions[0]?.slug ?? ""}`)}`
        claim.target = "_blank"
        claim.rel = "external"
        claim.textContent = "认领翻译 →"
        cta.append(claim)
        refusal.append(cta)
        box.append(refusal)
        box.append(renderReport(response))
        return box
      }

      const answer = el("div", "ask-answer")
      for (const line of response.answer.split("\n")) {
        answer.append(el("p", undefined, line))
      }
      box.append(answer)
      box.append(renderCitations(response.citations))
      if (response.stalePages.length > 0) {
        box.append(
          el("p", "ask-stale", `注意：${response.stalePages.map((page) => `《${page.slug}》`).join("、")} 的译文落后于上游。`)
        )
      }
      box.append(el("p", "ask-disclaimer", response.disclaimer))
      box.append(renderReport(response))
      return box
    }

    /** 追问时回传的上下文：只有"问题 + 引用了哪一页哪一节"，**不含上一轮的模型正文** */
    const historyPayload = (): ReadonlyArray<{
      question: string
      citations: ReadonlyArray<{ slug: string; title: string; anchor?: string }>
    }> =>
      turns
        .filter((turn) => turn.response !== undefined && turn.response.refused !== true)
        .slice(-HISTORY_TURNS)
        .map((turn) => ({
          question: turn.question,
          citations: (turn.response?.citations ?? []).slice(0, 5).map((citation) => ({
            slug: citation.slug,
            title: citation.title,
            ...(citation.anchor !== undefined ? { anchor: citation.anchor } : {})
          }))
        }))

    const renderThread = (): void => {
      body.textContent = ""
      if (turns.length === 0) {
        while (initial.firstChild !== null) body.append(initial.firstChild)
        if (resetButton !== null) resetButton.hidden = true
        return
      }
      if (resetButton !== null) resetButton.hidden = false
      const thread = el("div", "ask-thread")
      for (const turn of turns) {
        const item = el("div", "ask-turn")
        const question = el("p", "ask-turn-q")
        question.append(el("span", "ask-turn-who", "你"))
        question.append(document.createTextNode(turn.question))
        item.append(question)
        if (turn.element !== undefined) {
          if (turn.response?.resolvedQuestion !== undefined) {
            item.append(
              el("p", "ask-resolved", `小效把这句理解成：${turn.response.resolvedQuestion}`)
            )
          }
          item.append(turn.element)
        } else {
          item.append(el("p", "ask-hint", "正在检索站内译文…"))
        }
        thread.append(item)
      }
      body.append(thread)
      body.scrollTop = body.scrollHeight
    }

    const ask = async (question: string): Promise<void> => {
      // 先取历史（此刻本轮还没入列），再入列本轮 —— 顺序反了就会把自己的问题当成上文
      const history = historyPayload()
      const turn: Turn = { question }
      turns.push(turn)
      renderThread()
      try {
        const response = await fetch("/api/knowledge/ask", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            question,
            ...(scope !== "" ? { scope } : {}),
            ...(history.length > 0 ? { history } : {})
          })
        })
        if (response.status === 429) {
          const payload = (await response.json()) as { retryAfterSeconds?: number }
          turn.element = el(
            "p",
            "ask-hint",
            `提问太频繁了，请 ${payload.retryAfterSeconds ?? 60} 秒后再试。`
          )
          renderThread()
          return
        }
        if (!response.ok) throw new Error(String(response.status))
        const decoded = (await response.json()) as AskResponse
        turn.response = decoded
        turn.element = answerBlock(decoded)
      } catch {
        turn.element = await localBlock(question)
      }
      renderThread()
    }

    let lastFocused: HTMLElement | null = null

    const open = (): void => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null
      overlay.hidden = false
      document.documentElement.dataset.askOpen = "1"
      input.focus()
      // 只有在打开时才探测模式，避免给每个页面增加无谓请求
      if (modeLabel !== null && modeLabel.dataset.loaded !== "1") {
        fetch("/api/knowledge/stats")
          .then((response) => (response.ok ? response.json() : Promise.reject(new Error("no"))))
          .then((stats: { llmEnabled: boolean; llmModel?: string; pages: number }) => {
            const mode = stats.llmEnabled ? `模型润色（${stats.llmModel ?? "已启用"}）` : "检索合成"
            modeLabel.textContent = `${mode} · 已收录 ${stats.pages} 篇译文`
            modeLabel.dataset.loaded = "1"
          })
          .catch(() => {
            modeLabel.textContent = "后端未部署"
          })
      }
    }

    const close = (): void => {
      overlay.hidden = true
      delete document.documentElement.dataset.askOpen
      lastFocused?.focus()
      lastFocused = null
    }
    const isOpen = (): boolean => overlay.hidden === false

    form.addEventListener("submit", (event) => {
      event.preventDefault()
      const question = input.value.trim()
      if (question === "" || busy) return
      busy = true
      input.value = ""
      syncUrl(question)
      void ask(question).finally(() => {
        busy = false
      })
    })

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "i") {
        event.preventDefault()
        if (isOpen()) close()
        else open()
        return
      }
      if (isOpen() && event.key === "Escape") {
        event.preventDefault()
        close()
      }
    })

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) close()
    })

    document.addEventListener("ecn:ask", (event) => {
      const detail = (event as CustomEvent<{ question?: string; prefill?: string }>).detail
      open()
      if (detail?.question !== undefined && detail.question.trim() !== "") {
        void ask(detail.question.trim())
        return
      }
      // 选中即问：只把选中文本填进输入框（不替用户提交），让人确认或改写后再回车
      if (detail?.prefill !== undefined && detail.prefill.trim() !== "") {
        input.value = detail.prefill
        input.focus()
        input.setSelectionRange(input.value.length, input.value.length)
      }
    })

    resetButton?.addEventListener("click", () => {
      turns.length = 0
      renderThread()
      input.focus()
    })

    document.querySelectorAll("[data-ask-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault()
        open()
      })
    })

    /**
     * 让"问题"变成可寻址的 URL：/ask?q=怎么安装%20Effect
     *
     * 为什么：答案可以分享（"看这个引用"）、可以收藏、可以贴进 Issue/群聊；
     * 对 Agent 而言这也是一个**稳定入口** —— 给 URL 就能拿到同一个问题。
     * 只在 /ask 独立页面同步 URL（文档页的浮层不改地址栏，避免打断阅读）。
     */
    const syncUrl = (question: string): void => {
      if (overlay.dataset.standalone !== "1") return
      const url = question.trim() === "" ? location.pathname : `${location.pathname}?q=${encodeURIComponent(question)}`
      history.replaceState(null, "", url)
    }

    const askNow = (question: string): void => {
      input.value = question
      syncUrl(question)
      busy = true
      void ask(question).finally(() => {
        busy = false
      })
    }

    document.querySelectorAll(".ask-example").forEach((button) => {
      button.addEventListener("click", () => {
        const question = button.getAttribute("data-question")
        if (question !== null) askNow(question)
      })
    })

    // /ask 独立页面：直接展开，便于人/Agent 打开即用；带 ?q= 时直接作答
    if (overlay.dataset.standalone === "1") {
      open()
      const preset = new URLSearchParams(location.search).get("q")
      if (preset !== null && preset.trim() !== "") askNow(preset)
    }
  }
</script>
