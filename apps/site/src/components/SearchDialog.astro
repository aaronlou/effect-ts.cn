---
/**
 * 站内搜索：⌘/Ctrl+K 打开。数据来自构建期生成的 /search-index.json（无第三方依赖、无后端）。
 * 渐进增强：无 JS 时该组件不可用，但站点其他功能完全不受影响。
 */
---

<div id="ecn-search" class="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <input
      id="ecn-search-input"
      class="search-input"
      type="search"
      placeholder="搜索文档、章节、博客…"
      autocomplete="off"
      spellcheck="false"
    />
    <ul id="ecn-search-results" class="search-results"></ul>
    <div class="search-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
      <span class="search-hint-ask">
        <button type="button" id="ecn-search-ask">问文档 <kbd>⌘I</kbd></button>
      </span>
      <span class="search-hint-open"><kbd>⌘</kbd><kbd>K</kbd></span>
    </div>
  </div>
</div>

<script>
  interface SearchEntry {
    type: "doc" | "blog"
    title: string
    url: string
    section: string
    translated: boolean
    text: string
  }

  const overlay = document.getElementById("ecn-search")
  const input = document.getElementById("ecn-search-input") as HTMLInputElement | null
  const list = document.getElementById("ecn-search-results")

  if (overlay instanceof HTMLElement && input !== null && list !== null) {
    let index: SearchEntry[] | null = null
    let matches: SearchEntry[] = []
    let active = -1

    const loadIndex = async (): Promise<SearchEntry[]> => {
      if (index !== null) return index
      const response = await fetch("/search-index.json")
      index = (await response.json()) as SearchEntry[]
      return index
    }

    const score = (entry: SearchEntry, query: string): number => {
      const title = entry.title.toLowerCase()
      if (title.startsWith(query)) return 100
      if (title.includes(query)) return 60
      if (entry.section.toLowerCase().includes(query)) return 30
      if (entry.text.toLowerCase().includes(query)) return 10
      return 0
    }

    const search = async (query: string): Promise<SearchEntry[]> => {
      const entries = await loadIndex()
      const q = query.trim().toLowerCase()
      if (q === "") {
        // 默认展示：已翻译文档 + 博客
        return entries.filter((entry) => entry.translated).slice(0, 12)
      }
      return entries
        .map((entry) => ({ entry, s: score(entry, q) }))
        .filter((item) => item.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 12)
        .map((item) => item.entry)
    }

    const render = (): void => {
      list.innerHTML = ""
      if (matches.length === 0) {
        const empty = document.createElement("li")
        empty.className = "search-empty"
        empty.textContent = "没有匹配结果 —— 也可能是这一页尚未翻译。"
        list.append(empty)
        // 搜索是"找页面"，问答是"要答案"：搜不到时直接把问题交给问答，别让用户走进死路
        const askItem = document.createElement("li")
        askItem.className = "search-item"
        const askButton = document.createElement("button")
        askButton.type = "button"
        askButton.className = "search-ask-action"
        askButton.textContent = "用站内文档问答试试 →"
        askButton.addEventListener("click", () => askWith(input.value))
        askItem.append(askButton)
        list.append(askItem)
        return
      }
      matches.forEach((entry, i) => {
        const item = document.createElement("li")
        item.className = i === active ? "search-item active" : "search-item"
        const link = document.createElement("a")
        link.href = entry.url

        const title = document.createElement("span")
        title.className = "search-title"
        title.textContent = entry.title

        const meta = document.createElement("span")
        meta.className = "search-meta"
        const kind = entry.type === "blog" ? "博客" : "文档"
        meta.textContent = `${kind}${entry.translated ? "" : " · 未翻译（英文原文）"}${entry.section !== "" ? ` · ${entry.section.slice(0, 40)}` : ""}`

        link.append(title, meta)
        item.append(link)
        list.append(item)
      })
    }

    const setActive = (next: number): void => {
      if (matches.length === 0) return
      active = (next + matches.length) % matches.length
      render()
      const current = list.querySelector(".search-item.active")
      if (current instanceof HTMLElement) current.scrollIntoView({ block: "nearest" })
    }

    let lastFocused: HTMLElement | null = null

    /** 把问题交给问答面板（搜索无结果时的出口） */
    const askWith = (question: string): void => {
      closeSearch()
      document.dispatchEvent(new CustomEvent("ecn:ask", { detail: { question } }))
    }

    const openSearch = async (): Promise<void> => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null
      overlay.hidden = false
      input.value = ""
      active = 0
      matches = await search("")
      render()
      input.focus()
    }

    const closeSearch = (): void => {
      overlay.hidden = true
      lastFocused?.focus()
      lastFocused = null
    }

    const isOpen = (): boolean => overlay.hidden === false

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault()
        if (isOpen()) closeSearch()
        else void openSearch()
        return
      }
      if (!isOpen()) return
      if (event.key === "Escape") {
        event.preventDefault()
        closeSearch()
      } else if (event.key === "ArrowDown") {
        event.preventDefault()
        setActive(active + 1)
      } else if (event.key === "ArrowUp") {
        event.preventDefault()
        setActive(active - 1)
      } else if (event.key === "Enter") {
        const target = matches[active]
        if (target !== undefined) {
          event.preventDefault()
          window.location.href = target.url
        }
      }
    })

    input.addEventListener("input", () => {
      void search(input.value).then((result) => {
        matches = result
        active = result.length > 0 ? 0 : -1
        render()
      })
    })

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) closeSearch()
    })

    document.getElementById("ecn-search-ask")?.addEventListener("click", () => askWith(input.value))

    document.querySelectorAll("[data-search-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault()
        void openSearch()
      })
    })
  }
</script>
