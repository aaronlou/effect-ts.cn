---
/**
 * 侧边栏导航：结构镜像官方（来自 docs-nav.json）。
 * 已翻译条目显示中文标题；未翻译条目仍指向站内（占位页会给出英文原文与认领入口），
 * 并用 EN 徽章提示"尚未有中文译文"。
 */
import { docsNav, type NavSection } from "../lib/docs"

interface Props {
  version: string
  current: string
  /** 已翻译条目：slug → 中文标题 */
  translations: Readonly<Record<string, string>>
}

const { version, current, translations } = Astro.props
const sections: ReadonlyArray<NavSection> = docsNav.versions[version] ?? []
---

<nav class="docs-nav" aria-label="文档目录">
  {
    sections.map((section) => (
      <div class="docs-nav-section">
        <div class="docs-nav-title">{section.label}</div>
        <ul>
          {section.items.map((item) => {
            const translatedTitle = translations[item.slug]
            return (
              <li class={item.slug === current ? "active" : ""}>
                <a href={`/docs/${item.slug}/`} class={translatedTitle === undefined ? "pending" : ""}>
                  {translatedTitle ?? item.label}
                  {translatedTitle === undefined && <span class="badge dim">EN</span>}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    ))
  }
</nav>
