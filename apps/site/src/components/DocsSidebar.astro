---
/**
 * 侧边栏导航：结构镜像官方（来自 docs-nav.json），已翻译条目用中文标题并链接站内，
 * 未翻译条目链接到 effect.website 英文原文并标注 EN。
 */
import { docsNav, officialUrl, type NavSection } from "../lib/docs"

interface Props {
  version: string
  current: string
  /** 已翻译条目：slug → 中文标题 */
  translations: Readonly<Record<string, string>>
}

const { version, current, translations } = Astro.props
const sections: ReadonlyArray<NavSection> = docsNav.versions[version] ?? []
---

<nav class="docs-nav" aria-label="文档目录">
  {
    sections.map((section) => (
      <div class="docs-nav-section">
        <div class="docs-nav-title">{section.label}</div>
        <ul>
          {section.items.map((item) => {
            const translatedTitle = translations[item.slug]
            const isTranslated = translatedTitle !== undefined
            return (
              <li class={item.slug === current ? "active" : ""}>
                <a
                  href={isTranslated ? `/docs/${item.slug}/` : officialUrl(item.slug)}
                  class={isTranslated ? "" : "pending"}
                  {...(isTranslated ? {} : { target: "_blank", rel: "external" })}
                >
                  {translatedTitle ?? item.label}
                  {!isTranslated && <span class="badge dim">EN</span>}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    ))
  }
</nav>
