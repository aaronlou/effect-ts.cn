---
import Mascot from "./Mascot.astro"

/**
 * 「随时在场的 Agent」：全站常驻的问答入口 —— 吉祥物「小效」趴在这里等你。
 *
 * 为什么改成吉祥物：原来是一个"问 AI 在线 ⌘I"的胶囊，功能清楚但**不像有人在那儿**，
 * 也容易被当成又一个工具按钮忽略掉。站点需要一个能被记住、能被叫出名字的形象：
 * 一只猫（对应 Fiber 的"九条命"隐喻），项圈挂 Effect 徽记，名字叫「小效」。
 *
 * 它做四件事：
 * 1. **显眼但在场得安静**：右下角猫 + 两行文字（默认「问小效 / 可溯源引用」），
 *    带轻微呼吸动效；首次访问（每个会话一次）会冒出一句招呼气泡，之后不再打扰；
 * 2. **说真话的状态**：探测 `/api/knowledge/stats` —— 在线（可溯源引用）/ 本地（浏览器内检索降级），
 *    小效的**表情也跟着变**（在线眯眼微笑 / 降级睁大眼）；
 * 3. **随手问**：选中一段文字时变成「问这段」（小效"竖起耳朵"）；
 * 4. **让位**：问答面板打开时自动隐藏（CSS `html[data-ask-open]`）。
 */
---

<button
  type="button"
  id="ecn-agent-dock"
  class="agent-dock"
  data-state="unknown"
  data-selection="0"
  aria-label="问小效：站内中文文档问答（快捷键 ⌘I）"
  aria-haspopup="dialog"
  title="随时提问：答案只从站内译文合成，每条都带可点回的引用"
>
  <Mascot size={52} />

  <span class="agent-text">
    <span class="agent-label" id="ecn-agent-label">问小效</span>
    <span class="agent-status" id="ecn-agent-status">检查中…</span>
  </span>

  <kbd class="agent-kbd">⌘I</kbd>

  <!-- 首次访问的招呼气泡：每个会话最多出现一次，点任意处即消失 -->
  <span class="agent-bubble" id="ecn-agent-bubble" hidden>
    有问题随时问我，<br />答案都带引用喵～
  </span>
</button>

<script>
  const dock = document.getElementById("ecn-agent-dock")
  const label = document.getElementById("ecn-agent-label")
  const status = document.getElementById("ecn-agent-status")
  const bubble = document.getElementById("ecn-agent-bubble")

  if (dock instanceof HTMLElement && label !== null && status !== null) {
    const STATUS_KEY = "ecn:agent-status"
    const STATUS_TTL_MS = 5 * 60 * 1000
    const GREETED_KEY = "ecn:agent-greeted"

    /**
     * 状态探测：只请求一次，结果缓存 5 分钟（sessionStorage）。
     * 目的不是监控后端，而是**不骗人** —— 让用户知道小效现在是"能给出引用"还是"只能在浏览器里检索"；
     * 表情也跟着变（在线眯眼微笑 / 降级睁大眼），比一个小圆点更好读。
     */
    const probe = async (): Promise<void> => {
      try {
        const cached = sessionStorage.getItem(STATUS_KEY)
        if (cached !== null) {
          const parsed = JSON.parse(cached) as { online: boolean; at: number }
          if (Date.now() - parsed.at < STATUS_TTL_MS) {
            apply(parsed.online)
            return
          }
        }
      } catch {
        // 隐私模式等场景下 sessionStorage 不可用：忽略，直接探测
      }
      let online = false
      try {
        const response = await fetch("/api/knowledge/stats", { headers: { accept: "application/json" } })
        online = response.ok
      } catch {
        online = false
      }
      try {
        sessionStorage.setItem(STATUS_KEY, JSON.stringify({ online, at: Date.now() }))
      } catch {
        // 同上
      }
      apply(online)
    }

    const apply = (online: boolean): void => {
      dock.dataset.state = online ? "online" : "local"
      status.textContent = online ? "在线 · 带引用" : "本地检索"
      dock.title = online
        ? "小效在线：答案只从站内译文合成，每条都带可点回的引用"
        : "未连接问答服务：小效会自动降级为浏览器内检索（页面级候选 + 摘录）"
    }

    /** 选中即问：把"随手选中一段"变成最自然的提问方式 */
    const selectedText = (): string => {
      const selection = window.getSelection()
      if (selection === null || selection.isCollapsed) return ""
      const text = selection.toString().replace(/\s+/g, " ").trim()
      if (text.length < 6 || text.length > 300) return ""
      const anchor = selection.anchorNode
      const element = anchor instanceof Element ? anchor : anchor?.parentElement ?? null
      // 只认正文里的选中（别把页头/页脚/胶囊自身算进去）
      return element !== null && element.closest("main") !== null ? text : ""
    }

    const refreshSelection = (): void => {
      const text = selectedText()
      dock.dataset.selection = text === "" ? "0" : "1"
      label.textContent = text === "" ? "问小效" : "问这段"
      if (text !== "") dock.title = "把选中的这段交给小效（只预填，不替你提交）"
      else apply(dock.dataset.state === "online")
    }

    /** 首次访问的招呼：每个会话一次（sessionStorage），点一下或 8 秒后自动收起 */
    const greet = (): void => {
      if (bubble === null) return
      try {
        if (sessionStorage.getItem(GREETED_KEY) === "1") return
        sessionStorage.setItem(GREETED_KEY, "1")
      } catch {
        // 存不了就干脆不招呼，避免每次都冒泡
        return
      }
      // 等状态探测回来再出现，避免"检查中…"和招呼一起闪
      window.setTimeout(() => {
        bubble.hidden = false
        dock.dataset.greeted = "1"
        window.setTimeout(() => {
          bubble.hidden = true
          delete dock.dataset.greeted
        }, 8000)
      }, 900)
    }

    let debounce: number | undefined = undefined
    document.addEventListener("selectionchange", () => {
      if (debounce !== undefined) window.clearTimeout(debounce)
      debounce = window.setTimeout(refreshSelection, 180)
    })

    dock.addEventListener("click", () => {
      // 招呼气泡点掉即可，不拦着打开面板
      if (bubble !== null) {
        bubble.hidden = true
        delete dock.dataset.greeted
      }
      const text = selectedText()
      // AskPanel 监听的是 ecn:ask：有 prefill 时只预填（不替用户提交），否则只是打开面板
      document.dispatchEvent(new CustomEvent("ecn:ask", { detail: text === "" ? {} : { prefill: text } }))
    })

    void probe().then(greet)
  }
</script>
