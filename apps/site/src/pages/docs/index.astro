---
/**
 * 文档首页：展示"镜像官方结构"的章节进度，以及已上线的中文译文。
 */
import Base from "../../layouts/Base.astro"
import { getCollection } from "astro:content"
import {
  allVersions,
  docsNav,
  officialUrl,
  statusBadgeClass,
  statusLabels
} from "../../lib/docs"

const entries = await getCollection("docs")
const translated = new Map(entries.map((entry) => [entry.id, entry]))
const navHead = docsNav.generatedFrom.head ?? "unknown"

function progressOf(version: string): { total: number; done: number } {
  const items = (docsNav.versions[version] ?? []).flatMap((section) => section.items)
  return {
    total: items.length,
    done: items.filter((item) => translated.has(item.slug)).length
  }
}
---

<Base title="文档译站" description="Effect 官方文档的中文高质量译站（镜像官方结构，可追溯同步）">
  <section class="section" style="border-top: 0">
    <div class="container">
      <h1 style="margin: 0 0 0.25rem">文档译站 <span class="badge">镜像官方结构</span></h1>
      <p style="color: var(--fg-muted); max-width: 72ch">
        目录与官方 <a href="https://effect.website/docs/v4" rel="external">effect.website</a>
        保持一致（v4 为主线、v3 并存），由内容管线从官方仓库 <code>Effect-TS/website</code>
        自动生成；每页译文都标注所对照的上游 commit，落后会被
        <a href="/docs/translation-status/">翻译进度</a> 标红。未翻译条目直接指向英文原文并标
        <span class="badge dim">EN</span>。
      </p>
      <p style="color: var(--fg-faint); font-size: 0.85rem">
        导航生成自上游 <code>{navHead.slice(0, 7)}</code> · 已入库译文 {entries.length} 篇
      </p>
    </div>
  </section>

  {
    allVersions.map((version) => {
      const sections = docsNav.versions[version] ?? []
      const { total, done } = progressOf(version)
      return (
        <section class="section">
          <div class="container">
            <h2 style="margin-bottom: 0.5rem">
              {version} <span class="badge dim">{done}/{total} 已翻译</span>
            </h2>
            <div class="card-grid">
              {sections.map((section) => {
                const translatedItems = section.items.filter((item) => translated.has(item.slug))
                const firstSlug = section.items[0]?.slug
                return (
                  <div class="card">
                    <h3>
                      {section.label}{" "}
                      <span class="badge dim">
                        {translatedItems.length}/{section.items.length}
                      </span>
                    </h3>
                    {translatedItems.length > 0 ? (
                      <ul style="margin: 0.4rem 0 0; padding-left: 1.1rem; font-size: 0.92rem">
                        {translatedItems.map((item) => {
                          const entry = translated.get(item.slug)
                          const status = entry?.data.status ?? "pending"
                          return (
                            <li>
                              <a href={`/docs/${item.slug}/`}>{entry?.data.title ?? item.label}</a>{" "}
                              <span class={`badge ${statusBadgeClass[status] ?? ""}`}>
                                {statusLabels[status] ?? status}
                              </span>
                            </li>
                          )
                        })}
                      </ul>
                    ) : (
                      <p>
                        待翻译 ·{" "}
                        {firstSlug !== undefined && (
                          <a href={`/docs/${firstSlug}/`}>查看该章节（含英文原文入口）</a>
                        )}
                      </p>
                    )}
                  </div>
                )
              })}
            </div>
          </div>
        </section>
      )
    })
  }
</Base>
