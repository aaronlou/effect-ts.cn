---
/**
 * 文档页面路由：/docs/<version>/<section>/<page>/
 *
 * 两类页面共用同一路由：
 * - translated：已入库的中文译文（渲染 MDX + TOC + 上下页 + 同步元数据）
 * - placeholder：官方有、但我们尚未翻译的页面 —— 生成占位页而不是 404，
 *   提供「读英文原文」与「认领翻译」两个出口（站内链接因此永不失效）
 */
import Base from "../../layouts/Base.astro"
import AdSlot from "../../components/AdSlot.astro"
import DocsSidebar from "../../components/DocsSidebar.astro"
import AskPanel from "../../components/AskPanel.astro"
import { mdxComponents } from "../../components/mdx"
import { MACHINE_REVIEW_NOTE, isMachineReviewer } from "../../data/provenance"
import { getCollection, render } from "astro:content"
import {
  allVersions,
  claimUrl,
  counterpartSlug,
  docsNav,
  editUrl,
  flatItems,
  officialUrl,
  statusBadgeClass,
  statusLabels,
  versionOf
} from "../../lib/docs"

export async function getStaticPaths() {
  const entries = await getCollection("docs")
  const translated = entries.filter((entry) => entry.data.draft !== true)
  const translatedIds = new Set(translated.map((entry) => entry.id))

  const translatedPaths = translated.map((entry) => ({
    params: { slug: entry.id },
    props: { kind: "translated" as const, entry, slug: entry.id }
  }))

  // 官方有、但我们尚未翻译的页面：生成占位页而不是 404
  const placeholderPaths: Array<{
    params: { slug: string }
    props: {
      kind: "placeholder"
      slug: string
      version: string
      sectionLabel: string
      label: string
      upstreamPath: string
    }
  }> = []

  for (const [version, sections] of Object.entries(docsNav.versions)) {
    for (const section of sections) {
      for (const item of section.items) {
        if (translatedIds.has(item.slug)) continue
        placeholderPaths.push({
          params: { slug: item.slug },
          props: {
            kind: "placeholder",
            slug: item.slug,
            version,
            sectionLabel: section.label,
            label: item.label,
            upstreamPath: item.upstreamPath
          }
        })
      }
    }
  }

  return [...translatedPaths, ...placeholderPaths]
}

const props = Astro.props
const slug: string = props.slug
const doc = props.kind === "translated" ? props.entry : undefined
const rendered = doc !== undefined ? await render(doc) : undefined
const Content = rendered?.Content
const headings = rendered?.headings ?? []

const version: string = props.kind === "translated" ? versionOf(props.entry.id) : props.version
const placeholderLabel = props.kind === "placeholder" ? props.label : undefined
const placeholderSection = props.kind === "placeholder" ? props.sectionLabel : undefined
const placeholderUpstreamPath = props.kind === "placeholder" ? props.upstreamPath : undefined

const title = doc?.data.title ?? placeholderLabel ?? slug
const description = doc?.data.description

const allEntries = await getCollection("docs")
const translations: Record<string, string> = {}
for (const entry of allEntries) {
  translations[entry.id] = entry.data.title
}

const sections = docsNav.versions[version] ?? []

/** 上/下页：在"已翻译条目"内按官方顺序导航 */
const translatedSlugs = flatItems(version)
  .map((item) => item.slug)
  .filter((candidate) => translations[candidate] !== undefined)
const position = translatedSlugs.indexOf(slug)
const prevSlug = position > 0 ? translatedSlugs[position - 1] : undefined
const nextSlug =
  position >= 0 && position < translatedSlugs.length - 1
    ? translatedSlugs[position + 1]
    : undefined
const labelOf = (target: string): string => {
  for (const section of sections) {
    const item = section.items.find((candidate) => candidate.slug === target)
    if (item !== undefined) return translations[target] ?? item.label
  }
  return target
}

const status = doc?.data.status
const upstreamPath = doc?.data.upstreamPath ?? placeholderUpstreamPath ?? `${slug}.mdx`
const baseline =
  doc?.data.upstreamCommit === undefined ? "未标注基线" : doc.data.upstreamCommit.slice(0, 7)
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)

/**
 * 报告翻译问题的 issue 链接。
 *
 * 全部上下文在**构建期**就写进 href：即使 JS 没跑（或被禁用），用户点开也是一个
 * 信息完整的 issue，而不是一个空模板。JS 只负责**追加**他选中的那段原文。
 *
 * 为什么必须有这个入口：234 页译文**没有经过人类逐篇精读**，而此前发现错误的通道
 * 只有"用户自己去开 issue" —— 门槛高到几乎没人会做。这是内容质量唯一的输入源。
 */
const reportHref = ((): string => {
  const title = `[翻译问题] ${doc?.data.title ?? slug}`
  const body = [
    `**页面**：https://effect-ts.cn/docs/${slug}/`,
    `**译文章节**：\`${slug}\``,
    `**上游文件**：\`${upstreamPath}\``,
    `**翻译基线**：\`${baseline}\``,
    ``,
    `**问题类型**（保留适用的，其余删掉）：错译 / 漏译 / 术语 / 代码块 / 链接失效`,
    ``,
    `**问题描述**：`,
    ``,
    ``,
    `**涉及的原文**（在页面上选中一段再点报告按钮，会自动填在这里）：`,
    `> `
  ].join("\n")
  return `https://github.com/aaronlou/effect-ts.cn/issues/new?labels=translation&title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`
})()

const versionLinks = allVersions
  .filter((candidate) => candidate !== version)
  .map((candidate) => ({
    version: candidate,
    slug: counterpartSlug(slug, candidate)
  }))
---

<Base
  title={title}
  description={description}
  withAsk={false}
  docSlug={slug}
  docVersion={version}
  docCommit={doc?.data.upstreamCommit}
>
  <div class="container docs-layout">
    <aside class="docs-aside">
      <div class="version-switch">
        <span class="version-switch-label">版本</span>
        {
          allVersions.map((candidate) => {
            const counterpart = counterpartSlug(slug, candidate)
            const isCurrent = candidate === version
            const href =
              counterpart !== undefined
                ? `/docs/${counterpart}/`
                : isCurrent
                  ? `/docs/${slug}/`
                  : "#"
            return (
              <a
                href={href}
                class:list={["version-pill", isCurrent && "active"]}
                title={isCurrent ? "当前版本" : "切换到该版本"}
              >
                {candidate}
              </a>
            )
          })
        }
      </div>
      <DocsSidebar version={version} current={slug} translations={translations} />
    </aside>

    <article class="docs-main">
      {
        doc !== undefined ? (
          <>
            <div class="docs-meta">
              <span class={`badge ${statusBadgeClass[status ?? "pending"] ?? ""}`}>
                {statusLabels[status ?? "pending"] ?? status}
              </span>
              <span class="docs-baseline" title="翻译所对照的上游 commit">
                上游基线 <code>{baseline}</code>
              </span>
              <button type="button" class="ask-trigger" data-ask-open title="就这一页提问（⌘I）">
                问这一页 <kbd>⌘I</kbd>
              </button>
              <span class="docs-meta-links">
                <a href={officialUrl(slug)} target="_blank" rel="external">
                  原文 ↗
                </a>
                <a href={editUrl(slug)} target="_blank" rel="external">
                  在 GitHub 编辑
                </a>
              </span>
            </div>

            <h1>{doc.data.title}</h1>
            {doc.data.description && <p class="docs-desc">{doc.data.description}</p>}

            {/* id="intro"：页首小节的引用锚点（见 packages/content/src/corpus.ts 的 PAGE_LEAD_ANCHOR） */}
            <div class="prose" id="intro">
              {Content !== undefined && <Content components={mdxComponents} />}
            </div>

            <footer class="docs-foot">
              <div class="docs-foot-note">
                本文是官方{" "}
                <a href={officialUrl(slug)} target="_blank" rel="external">
                  effect.website
                </a>{" "}
                的社区中文译文（<code>{upstreamPath}</code>，基线 <code>{baseline}</code>）； 译者：
                {doc.data.translators.join("、") || "—"}；审校：
                {doc.data.reviewers
                  .map((reviewer) =>
                    isMachineReviewer(reviewer) ? `${reviewer}（${MACHINE_REVIEW_NOTE}）` : reviewer
                  )
                  .join("、") || "—"}。
              </div>
              {/*
                报告翻译问题。

                为什么必须有这个入口：234 页译文目前**没有经过人类逐篇精读**，
                而发现错误的通道此前只有"用户自己去开 issue" —— 门槛高到几乎没人会做。
                这是内容质量唯一的输入源。

                href 在**构建期**就已带齐 slug / 上游文件 / 翻译基线 ——
                没有 JS 也能正常提交（只是带不上选中的原文）。
              */}
              <p class="docs-report-line">
                发现错译、漏译或术语问题？
                <a id="ecn-report-translation" class="docs-report" href={reportHref} target="_blank" rel="external">
                  报告这页的翻译问题
                </a>
                <span class="docs-report-hint">（在正文里选中一段再点，会自动带上那段原文）</span>
              </p>

              <nav class="docs-pager" aria-label="上下页">
                {
                  prevSlug !== undefined ? (
                    <a class="docs-pager-link prev" href={`/docs/${prevSlug}/`}>
                      <span>← 上一篇</span>
                      <strong>{labelOf(prevSlug)}</strong>
                    </a>
                  ) : (
                    <span />
                  )
                }
                {
                  nextSlug !== undefined ? (
                    <a class="docs-pager-link next" href={`/docs/${nextSlug}/`}>
                      <span>下一篇 →</span>
                      <strong>{labelOf(nextSlug)}</strong>
                    </a>
                  ) : (
                    <span />
                  )
                }
              </nav>
            </footer>
          </>
        ) : (
          <div class="placeholder-card">
            <div class="docs-meta">
              <span class="badge dim">待翻译</span>
              <span class="docs-baseline">
                {placeholderSection} · <code>{placeholderUpstreamPath}</code>
              </span>
              <span class="docs-meta-links">
                <a href={officialUrl(slug)} target="_blank" rel="external">
                  原文 ↗
                </a>
              </span>
            </div>
            <h1>{placeholderLabel}</h1>
            <p style="color: var(--fg-muted)">
              这一页还没有中文译文。官方英文原文已经写好了，建议先读它；如果你愿意，也欢迎认领这一页 ——
              翻译规范见仓库的
              <a
                href="https://github.com/aaronlou/effect-ts.cn/blob/main/docs/translation-guide.md"
                target="_blank"
                rel="external"
              >
                译者指南
              </a>。
            </p>
            <div class="cta-row">
              <a class="btn btn-primary" href={officialUrl(slug)} target="_blank" rel="external">
                阅读英文原文 ↗
              </a>
              <a class="btn btn-ghost" href={claimUrl(slug)} target="_blank" rel="external">
                认领翻译
              </a>
              <button type="button" class="btn btn-ghost" data-ask-open>
                问站内中文文档 <kbd>⌘I</kbd>
              </button>
            </div>
          </div>
        )
      }
    </article>

    {/* 广告只放在**正文读完之后**：读者想找下一步时才出现，不切断阅读。
        未配置时组件输出零字节，不留空白。 */}
    <AdSlot variant="articleEnd" />

    <aside class="docs-toc">
      {
        doc !== undefined && toc.length > 0 && (
          <div class="docs-toc-inner">
            <div class="docs-toc-title">本页目录</div>
            <ul>
              {toc.map((heading) => (
                <li class:list={[`depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="docs-toc-inner docs-toc-version">
        {versionLinks.map((link) => (
          <div>
            {link.version}：
            {link.slug !== undefined ? (
              <a href={`/docs/${link.slug}/`}>对应页面</a>
            ) : (
              <span class="muted">无对应页面</span>
            )}
          </div>
        ))}
      </div>
    </aside>
  </div>

  <AskPanel scope={doc !== undefined ? doc.id : undefined} />

  <script>
    import "../../scripts/enhance-code"
    import { readSelection, watchSelection } from "../../scripts/selection"

    /**
     * 让「报告翻译问题」带上用户选中的原文。
     *
     * 关键点：**不去拦截点击，而是提前把 href 改好**。
     * 点链接时浏览器会先清掉选区（mousedown 落在选区之外），所以点击那一刻再读就晚了；
     * 而且改 href 而不是 preventDefault + window.open，还避开了弹窗拦截。
     */
    const report = document.getElementById("ecn-report-translation")
    if (report instanceof HTMLAnchorElement) {
      const base = report.href
      const withQuote = (text: string): string => `${base}${encodeURIComponent(`\n> ${text.replace(/\n+/g, " ")}`)}`
      watchSelection((snapshot) => {
        // 只认本页正文里的选区；没有选区就退回不带原文的链接
        report.href = snapshot !== null ? withQuote(snapshot.text) : base
      })
      // 兜底：有些浏览器在 hover/点击前不触发 selectionchange 的稳定回调
      report.addEventListener("pointerenter", () => {
        const live = readSelection()
        if (live !== null) report.href = withQuote(live.text)
      })
    }
  </script>
</Base>
