---
/**
 * 翻译进度仪表盘：数据来自译文 frontmatter 与上游快照比对（packages/content）。
 */
import Base from "../../layouts/Base.astro"
import { getCollection } from "astro:content"
import { allVersions, statusBadgeClass, statusLabels, versionOf } from "../../lib/docs"
import { MACHINE_REVIEW_DETAIL, isMachineReviewer } from "../../data/provenance"

const entries = await getCollection("docs")
const statusOrder = ["published", "reviewing", "translating", "pending", "stale"]

const total = entries.length
const stale = entries.filter((entry) => entry.data.status === "stale").length
const published = entries.filter((entry) => entry.data.status === "published").length
const missingBaseline = entries.filter(
  (entry) => entry.data.upstreamPath === undefined || entry.data.upstreamCommit === undefined
).length

/** 有多少篇是「只有机器可复核、没有人类精读署名」的 */
const machineOnlyReviewed = entries.filter(
  (entry) =>
    entry.data.reviewers.length > 0 && entry.data.reviewers.every((r) => isMachineReviewer(r))
).length

const byVersion = allVersions.map((version) => {
  const list = entries.filter((entry) => versionOf(entry.id) === version)
  const counts: Record<string, number> = {}
  for (const status of statusOrder) {
    counts[status] = list.filter((entry) => entry.data.status === status).length
  }
  return { version, total: list.length, counts }
})
---

<Base title="翻译进度" description="译文同步状态仪表盘">
  <section class="section" style="border-top: 0">
    <div class="container">
      <h1 style="margin: 0 0 0.25rem">翻译进度 <span class="badge">数据公开</span></h1>
      <p style="color: var(--fg-muted); max-width: 72ch">
        每篇译文在 frontmatter 记录 <code>upstreamPath</code> / <code>upstreamCommit</code>；
        内容管线（<code>packages/content</code>）比对上游仓库 <code>Effect-TS/website</code>，
        产出「落后清单」并在每日巡检里开 issue。
        <strong>注意现状</strong>：自动比对只产出报告，<em>不会</em>回写
        <code>status: stale</code> —— 因此下面这一列的「落后」在没有人工更新时恒为 0，
        真正落后时请看仓库的 <code>upstream-sync</code> issue 与 <code>stale-report.json</code>。
      </p>
      <p style="color: var(--fg-muted); max-width: 72ch; margin-top: 0.75rem">
        <strong>审校口径</strong>：{MACHINE_REVIEW_DETAIL}
        当前有 <strong>{machineOnlyReviewed}</strong> 篇属于「只有机器可复核、尚无人类精读署名」。
        维护者精读后会在 <code>reviewers</code> 里追加自己的名字。
      </p>
      <p style="margin-top: 1rem">
        总数 <strong>{total}</strong> · 已发布 <strong>{published}</strong> · 落后上游 <strong
          >{stale}</strong
        > · 缺基线 <strong>{missingBaseline}</strong>
      </p>

      <h2>按版本汇总</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>版本</th>
            <th>译文数</th>
            {statusOrder.map((status) => <th>{statusLabels[status] ?? status}</th>)}
          </tr>
        </thead>
        <tbody>
          {byVersion.map((row) => (
            <tr>
              <td><strong>{row.version}</strong></td>
              <td>{row.total}</td>
              {statusOrder.map((status) => <td>{row.counts[status] ?? 0}</td>)}
            </tr>
          ))}
        </tbody>
      </table>

      <h2>译文清单</h2>
      {entries.length === 0 ? (
        <div class="empty-state">
          <p><strong>还没有已入库的译文。</strong></p>
          <p>
            文档以 MDX 存于 <code>apps/site/src/content/docs/&lt;version&gt;/…</code>。
            想成为译者？从仓库的
            <a href="https://github.com/aaronlou/effect-ts.cn/blob/main/CONTRIBUTING.md" rel="external"
              >贡献指南</a
            >开始。
          </p>
        </div>
      ) : (
        <table class="data-table">
          <thead>
            <tr>
              <th>页面</th>
              <th>版本</th>
              <th>状态</th>
              <th>上游基线</th>
              <th>译者</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((entry) => (
              <tr>
                <td><a href={`/docs/${entry.id}/`}>{entry.data.title}</a></td>
                <td>{versionOf(entry.id)}</td>
                <td>
                  <span class={`badge ${statusBadgeClass[entry.data.status] ?? ""}`}>
                    {statusLabels[entry.data.status] ?? entry.data.status}
                  </span>
                </td>
                <td><code>{(entry.data.upstreamCommit ?? "—").slice(0, 7)}</code></td>
                <td>{entry.data.translators.join("、") || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>
</Base>
