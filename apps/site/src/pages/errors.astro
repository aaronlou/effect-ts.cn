---
/**
 * 报错百科：`/debug` 诊断过的报错，按"报错签名"沉淀成的公开条目。
 *
 * 为什么它值得存在：这份库**全网没有** —— 官方文档不收录报错，Stack Overflow 上 Effect 的
 * 报错几乎为零（太新，而且报错太长没人愿意贴），中文世界更是空白。
 * 而 Effect 最大的劝退点恰恰就是报错。
 *
 * 它还有一个别的功能没有的性质：**越用越厚**。每多一个人来问，这份库就厚一点，
 * 而命中同签名的提问是零 token 的。
 *
 * 两条诚实纪律（页面必须体现，不是可选项）：
 *   1. 条目默认是**机器生成、未经人审** —— 必须显著标注，不能让人以为有人确认过；
 *   2. 引用是**提问那一刻的快照** —— 译文基线变了以后它可能过时，所以每条都给出
 *      可点回原文的链接，让读者自己核对当前内容。
 *
 * 数据来自运行时接口（条目的增长本来就是运行时的），因此这里是静态壳 + 客户端拉取；
 * 后端不可用时给出诚实的降级说明，而不是假装"还没有条目"。
 */
import Base from "../layouts/Base.astro"
---

<Base
  title="报错百科"
  description="Effect / TypeScript 常见报错的检索索引：按报错签名归并，附中文文档引用。机器生成、未经人审。"
>
  <section class="section" style="border-top: 0">
    <div class="container">
      <h1 style="margin: 0 0 0.25rem">
        报错百科 <span class="badge">机器生成 · 未经人审</span>
      </h1>
      <p style="color: var(--fg-muted); max-width: 78ch">
        Effect 的类型报错又长又难读，而且<strong>搜不到</strong>——官方文档不收录报错，
        英文社区也很少有人愿意贴这么长的输出。这一页把站内诊断过的报错按
        <strong>报错签名</strong>归并起来（同一个报错在不同机器上路径、行列号、堆栈都不同，
        但底层是同一个问题），让它变成<strong>可搜索、可链接、可累积</strong>的东西。
      </p>
      <p style="color: var(--fg-muted); max-width: 78ch">
        <strong>请按"线索"而不是"结论"来用它。</strong>条目由机器从检索到的中文译文合成，
        尚未经人确认；引用是提问那一刻的快照，译文更新后可能过时 —— 所以每条都附了可点回原文的链接，
        建议核对后再采用。发现结论不对，欢迎
        <a href="https://github.com/aaronlou/effect-ts.cn/issues/new?labels=ai-feedback" rel="external"
          >提 issue</a
        >，那正是让它变准的方式。
      </p>

      <p class="errors-status" id="errors-status">正在读取…</p>

      <div class="errors-tools" id="errors-tools" hidden>
        <label class="errors-filter-label" for="errors-filter">筛选</label>
        <input
          id="errors-filter"
          class="errors-filter"
          type="search"
          placeholder="输入错误码或 API 名，例如 TS2345、Effect.gen、Layer"
          autocomplete="off"
        />
        <span class="errors-count" id="errors-count"></span>
      </div>

      <div class="errors-list" id="errors-list"></div>

      <p class="errors-foot">
        没有找到你的报错？把报错整段贴到<a href="/debug/">报错诊断</a>，诊断完它就会进这里。
      </p>
    </div>
  </section>
</Base>

<style>
  .errors-status {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .errors-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.4rem 0 1.2rem;
    flex-wrap: wrap;
  }
  .errors-filter-label {
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .errors-filter {
    flex: 1 1 22rem;
    min-width: 12rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--fg);
    font: inherit;
    font-size: 0.9rem;
  }
  .errors-count {
    font-size: 0.8rem;
    color: var(--fg-faint);
  }
  .errors-list {
    display: grid;
    gap: 0.9rem;
  }
  .error-entry {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 0.9rem 1rem;
  }
  .error-entry h2 {
    font-size: 1rem;
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
  }
  .error-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
  }
  .error-meta strong {
    color: var(--fg);
  }
  .error-sample {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--bg-code);
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
    margin: 0 0 0.6rem;
    max-height: 7.5rem;
    overflow: auto;
    white-space: pre-wrap;
    color: var(--fg-muted);
  }
  .error-answer {
    margin: 0 0 0.6rem;
  }
  .error-cites {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.85rem;
  }
  .error-cites li {
    margin: 0.15rem 0;
  }
  .error-unreviewed {
    color: var(--warn);
  }
  .errors-foot {
    margin-top: 1.6rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>

<script>
  interface ErrorEntry {
    signature: string
    codes: string[]
    symbols: string[]
    errorText: string
    answer: string
    mode: string
    citations: { title: string; url: string; anchor?: string; quote?: string }[]
    hits: number
    firstSeen: string
    lastSeen: string
    reviewed: boolean
  }

  const status = document.getElementById("errors-status")
  const tools = document.getElementById("errors-tools")
  const list = document.getElementById("errors-list")
  const filter = document.getElementById("errors-filter") as HTMLInputElement | null
  const count = document.getElementById("errors-count")

  const escapeHtml = (value: string): string =>
    value.replace(/[&<>"']/g, (char) =>
      char === "&" ? "&amp;" : char === "<" ? "&lt;" : char === ">" ? "&gt;" : char === '"' ? "&quot;" : "&#39;"
    )

  const relative = (iso: string): string => {
    const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000)
    if (days <= 0) return "今天"
    if (days === 1) return "昨天"
    if (days < 30) return `${days} 天前`
    return `${Math.floor(days / 30)} 个月前`
  }

  const render = (entries: ErrorEntry[]): void => {
    if (entries.length === 0) {
      list!.innerHTML = ""
      return
    }
    list!.innerHTML = entries
      .map((entry) => {
        const title = [entry.codes[0], ...entry.symbols.filter((s) => !s.includes(".")).slice(0, 3)]
          .filter(Boolean)
          .join(" · ")
        const cites = entry.citations
          .slice(0, 3)
          .map(
            (citation) =>
              `<li><a href="${escapeHtml(citation.url)}" rel="external">${escapeHtml(citation.title)}</a>${
                citation.anchor ? ` <code>#${escapeHtml(citation.anchor)}</code>` : ""
              }</li>`
          )
          .join("")
        return `<article class="error-entry" id="${escapeHtml(entry.signature)}">
  <h2>${escapeHtml(title || entry.signature)}</h2>
  <p class="error-meta">
    <span>被问到 <strong>${entry.hits}</strong> 次</span>
    <span>最近 ${relative(entry.lastSeen)}</span>
    <span class="error-unreviewed">${entry.reviewed ? "已人工确认" : "机器生成 · 未经人审"}</span>
    <code>${escapeHtml(entry.signature)}</code>
  </p>
  <pre class="error-sample">${escapeHtml(entry.errorText.slice(0, 600))}</pre>
  <p class="error-answer">${escapeHtml(entry.answer).slice(0, 400)}</p>
  ${cites ? `<ul class="error-cites">${cites}</ul>` : ""}
</article>`
      })
      .join("")
  }

  const matches = (entry: ErrorEntry, needle: string): boolean => {
    if (needle === "") return true
    const haystack = [entry.signature, entry.errorText, entry.answer, ...entry.codes, ...entry.symbols]
      .join(" ")
      .toLowerCase()
    return haystack.includes(needle)
  }

  const load = async (): Promise<void> => {
    try {
      const response = await fetch("/api/knowledge/errors?limit=200", { headers: { accept: "application/json" } })
      if (!response.ok) throw new Error(String(response.status))
      const data = (await response.json()) as { entries: ErrorEntry[]; total: number }
      const entries = data.entries ?? []
      if (entries.length === 0) {
        status!.textContent = "还没有条目 —— 把一段报错贴到「报错诊断」，诊断完它就会出现在这里。"
        return
      }
      status!.textContent = `共 ${data.total} 条签名，按被问次数排序。`
      tools!.hidden = false
      render(entries)
      const update = (): void => {
        const needle = (filter?.value ?? "").trim().toLowerCase()
        const filtered = entries.filter((entry) => matches(entry, needle))
        count!.textContent = needle === "" ? "" : `${filtered.length} / ${entries.length}`
        render(filtered)
      }
      filter?.addEventListener("input", update)
    } catch {
      // 诚实降级：后端不可用就说后端不可用，不要显示成"暂无条目"
      status!.textContent =
        "暂时读不到条目（问答后端未连接）。这不代表库是空的 —— 稍后刷新，或先用「报错诊断」。"
    }
  }

  void load()
</script>
