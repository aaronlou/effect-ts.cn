{
  "name": "@ecn/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "内容管线 CLI：译文状态/门禁校验、上游快照与 stale 比对、导航生成 —— “同步即信誉”的工程落点",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "status": "tsx src/cli.ts status",
    "check": "tsx src/cli.ts check",
    "corpus": "tsx src/cli.ts corpus",
    "cite:check": "tsx src/cli.ts cite:check",
    "proposals:check": "tsx src/cli.ts proposals:check",
    "proposals:list": "tsx src/cli.ts proposals:list"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ecn/knowledge": "workspace:*"
  }
}
