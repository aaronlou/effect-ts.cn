# effect-ts.cn 的 Caddy 配置。
#
# ⚠️ 这份是**服务器上实际生效的那份**的副本 —— 之前仓库里的版本落后于线上，
# 照它重新部署会**静默丢掉访问日志块与安全响应头**（发现时线上比仓库多了这两块）。
# 改完请同步到服务器：scp 过去后 `sudo systemctl reload caddy`。
#
# 线上用的是「接法 A」：Caddy 跑在宿主，站点容器只绑回环 127.0.0.1:18080。
# effect-ts.cn 的反向代理（Google Cloud / 境外服务器，无需 ICP 备案）
#
# 与国内那台的差别：这里 80/443 是干净的，Caddy 直接接管并自动申请 Let's Encrypt 证书。
# 站点容器仍然只绑回环（127.0.0.1:18080），公网只暴露 Caddy 这一层。

# 正式域名
effect-ts.cn {
	encode zstd gzip

	# 静态资源交给 Caddy 直接处理更省事，其它一律转给站点容器
	reverse_proxy 127.0.0.1:18080 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}


    # 自建统计（Umami，可选）：与站点**同源**挂在 /stats/ 下 ——
    # 同源是刻意的：跨域脚本在大陆更容易被拦，而自建的整个意义就是"不受封锁影响"。
    # 启用 analytics profile 后再打开这段（未启用时它会 502）：
    #
    # handle_path /stats/* {
    #     reverse_proxy 127.0.0.1:18081
    # }

	log {
		output file /var/log/caddy/effect-ts.cn.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# www 一律 301 到裸域。
#
# 原先 `effect-ts.cn, www.effect-ts.cn` 写在同一个块里 —— 两个主机名都返回 200，
# 等于同一份内容挂在两个地址上。页面里的 canonical 已经指向裸域（风险不大），
# 但 301 更干净。实测 Caddy 日志里 www 扛了 1134 次请求（约占全部流量的 22%），
# 那些抓取预算应该都花在正式域名上。
#
# log 块刻意保留：跳转记录也要看得见，否则会以为 www 的流量凭空消失了。
www.effect-ts.cn {
	redir https://effect-ts.cn{uri} permanent

	log {
		output file /var/log/caddy/effect-ts.cn.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
#
# ── 接法 B：Caddy 跑在 Docker 里，用外部网络直连容器 ─────────────────────
#   docker network create caddy && pnpm docker:up:caddy
#   然后把上面的 reverse_proxy 改成 `reverse_proxy ecn-web:80`。
#
# ── 接法 C：先只验收不接域名 ────────────────────────────────────────────
#   https://effect-ts.cn {
#       tls internal
#       reverse_proxy 127.0.0.1:18080
#   }
