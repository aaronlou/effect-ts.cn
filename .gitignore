# Agent 起草暂存（打包成 .proposals/*.json 后即可删除）
.proposals/.drafts/
.proposals/.parts/

# 生态榜采集产物（观测与缓存，可重新生成；入榜数据在 apps/site/src/data/ecosystem.json）
artifacts/

# 临时试验文件（跑 tsc 取真实报错用的脚手架，不该进仓库）
.tmp-errs/

# 播种跑批的报告产物（每次跑都会重新生成，不该进仓库）
scripts/.seed-report.json
