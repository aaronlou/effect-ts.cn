# ─────────────────────────────────────────────────────────────
# effect-ts.cn 本地/部署配置（复制为 .env 后填写）
#   cp .env.example .env
# 不配置任何 Key 也能完整运行：AI 走 extractive（检索合成 + 引用 + 拒答），零成本、完全可溯源。
# ─────────────────────────────────────────────────────────────

# ── 模型（可选，二选一）─────────────────────────────────────
#
# 配上 Key 之后，问答链路上会多出四件事（任何一步失败都只是"这一步不做"，不影响可用）：
#   1. 追问改写（指代消解）：把「它呢？」「那 v3 呢？」补全成可独立检索的查询；
#   2. 术语化扩展：第一次检索偏弱时，把白话换成 2~4 条"文档会用的说法"再做 RRF 融合
#      （实测「怎么让两件事同时跑？」在纯词法检索下会拒答，扩展后能命中 Fiber / 并发）；
#   3. 候选重排：只换引用顺序，不增删候选；
#   4. 答案合成：把检索到的证据写成连贯中文（引用仍由检索层构造，模型碰不到引用）。
# 一次追问最多 4 次模型调用（改写 + 扩展 + 重排 + 合成）；首问通常 1~2 次。

# 方式 A：DeepSeek（推荐：中文技术内容质量好、价格低）
# 拿到 Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat；换成 deepseek-reasoner 会更慢更贵，超时上限自动放大到 120s
# DEEPSEEK_MODEL=deepseek-chat
# 可选：走代理 / 自建网关时覆盖地址（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 方式 B：任意 OpenAI 兼容服务（OpenAI / Ollama / vLLM / 自建网关…）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
# LLM_TIMEOUT_MS=30000
# 显式声明提供方（存在 DEEPSEEK_API_KEY 时会自动识别为 deepseek，通常不用写）
# LLM_PROVIDER=deepseek

# ── Docker 部署（服务器上已有其它站点时看这里）──────────────────
# 站点容器只绑 127.0.0.1:WEB_PORT（不碰 80/443，交给已有的 Caddy/Nginx 反代）
# 先跑 `pnpm docker:ports` 看哪个端口空闲，再填进来
# WEB_PORT=18080
# 若 Caddy 也跑在 Docker 里，用它所在的网络名（默认 caddy）
# CADDY_NETWORK=caddy
# Postgres 口令（生产请改掉）
# POSTGRES_PASSWORD=change-me

# 生产服务器从 GHCR 拉预构建镜像（CI 在 main 分支构建 linux/amd64 并推送）：
# 服务器因此不需要 clone 仓库，也不需要 Node/pnpm 跑构建。
#   docker compose -f infra/docker-compose.prod.yml pull && ... up -d
# 不设这两项时用本地构建的 ecn-api:latest / ecn-site:latest（开发机 arm64 也适用）
# API_IMAGE=ghcr.io/aaronlou/effect-ts.cn/api:latest
# WEB_IMAGE=ghcr.io/aaronlou/effect-ts.cn/site:latest

# ── 成本闸门（公网部署强烈建议保持默认值）─────────────────────
# 每日 LLM token 预算：达到即**停止调用模型**，问答自动降级为检索合成（站点照常可用）。
# 默认 200 万 ≈ 每天 1500~2500 次带模型的问答（实测：润色约 490 + 重排约 320 token/次）。
# 设为 0 表示不限（本地开发用）。
# LLM_DAILY_TOKEN_BUDGET=2000000
# 单个来源每日提问次数上限：防止一个来源把全局预算吃光。0 = 不限。
# ASK_DAILY_LIMIT_PER_IP=80

# ── 服务（一般无需修改）───────────────────────────────────────
# API_PORT=8787
# ASK_RATE_LIMIT_PER_MINUTE=20
# DATABASE_URL=postgres://user:pass@localhost:5432/effect_ts_cn
# 是否信任反代写入的 X-Real-IP / X-Forwarded-For（默认 true）。
# 生产是 nginx 反代 + api 不发布宿主端口，保持 true；
# 若把 API 直接暴露到公网，务必设为 false，否则限流 key 可被伪造。
# TRUST_PROXY_HEADERS=true
